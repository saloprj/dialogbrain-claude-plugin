{
  "dialogbrain": {
    "type": "http",
    "url": "https://api.dialogbrain.com/mcp/"
  },
  "dialogbrain-channel": {
    "command": "node",
    "args": [
      "${CLAUDE_PLUGIN_ROOT}/channel/server.mjs"
    ],
    "env": {
      "DIALOGBRAIN_API_URL_DEFAULT": "https://api.dialogbrain.com",
      "DIALOGBRAIN_TOKEN": "${user_config.api_key}",
      "DIALOGBRAIN_CHANNEL_NAME": "${user_config.channel_name}"
    }
  }
}
